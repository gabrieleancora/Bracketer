# Replace the hostname and certificate paths before enabling this example.
# Use only one public proxy. The Gunicorn service binds 127.0.0.1:8000.
log_format bracketer_safe '$remote_addr $request_method $status $request_time';

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 80;
    server_name brackets.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name brackets.example.com;
    ssl_certificate /etc/letsencrypt/live/brackets.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/brackets.example.com/privkey.pem;
    access_log /var/log/nginx/bracketer-access.log bracketer_safe;
    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Protocol "";
        proxy_set_header Connection "";
        proxy_read_timeout 75s;
    }

    location ~ ^/api/brackets/[^/]+/events$ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Protocol "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_read_timeout 75s;
    }
}
